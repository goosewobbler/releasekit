{
  "$schema": "https://goosewobbler.github.io/releasekit/schema.json",
  "git": {
    "branch": "main",
    "skipHooks": true
  },
  "version": {
    "preset": "angular",
    "sync": true,
    "versionPrefix": "v",
    "packages": [
      "packages/version",
      "packages/notes",
      "packages/publish",
      "packages/release"
    ],
    "mismatchStrategy": "prefer-package",
    "commitMessage": "chore: release v${version} [skip ci]",
    "prereleaseIdentifier": "next",
    "baselineTagTemplate": "release/${prefix}${version}"
  },
  "notes": {
    "changelog": {
      "mode": "packages"
    },
    "releaseNotes": {
      "templates": {
        "path": "./templates/release-notes/release.liquid",
        "engine": "liquid"
      },
      "llm": {
        "provider": "ollama",
        "model": "minimax-m3.1-flash:cloud",
        "baseURL": "https://ollama.com/api",
        "tasks": {
          "enhance": true,
          "categorize": true
        },
        "categories": [
          {
            "name": "New",
            "description": "New features and additions",
            "scopes": [
              "standing-pr",
              "publish",
              "draft",
              "version",
              "notes",
              "config",
              "action",
              "examples"
            ]
          },
          {
            "name": "Fixed",
            "description": "Bug fixes including security and performance fixes",
            "scopes": [
              "standing-pr",
              "publish",
              "draft",
              "version",
              "notes",
              "config",
              "action",
              "examples"
            ]
          },
          {
            "name": "Changed",
            "description": "Changes to existing functionality",
            "scopes": [
              "standing-pr",
              "publish",
              "draft",
              "version",
              "notes",
              "config",
              "action",
              "examples"
            ]
          },
          {
            "name": "Removed",
            "description": "Features that were removed",
            "scopes": [
              "standing-pr",
              "publish",
              "draft",
              "version",
              "notes",
              "config",
              "action",
              "examples"
            ]
          },
          {
            "name": "Documentation",
            "description": "Documentation updates",
            "scopes": [
              "docs"
            ]
          },
          {
            "name": "Developer",
            "description": "Internal changes",
            "scopes": [
              "ci",
              "tests",
              "deps",
              "tooling"
            ]
          }
        ],
        "scopes": {
          "mode": "restricted",
          "rules": {
            "caseSensitive": false,
            "invalidScopeAction": "remove"
          }
        },
        "style": "Use past tense descriptions. Be concise. Focus on what changed, not implementation details.",
        "prompts": {
          "instructions": {
            "enhanceAndCategorize": "Set every entry's scope to the area it changes, from its category's list. Leave leadIn null: the scope is the entry's label."
          }
        }
      }
    }
  },
  "publish": {
    "githubRelease": {
      "body": "auto"
    }
  },
  "release": {
    "ci": {
      "skipPatterns": [
        "chore: release "
      ]
    }
  },
  "ci": {
    "releaseStrategy": "standing-pr",
    "releaseTrigger": "label",
    "scopeLabels": {
      "scope:all": "@releasekit/*"
    },
    "standingPr": {
      "branch": "release/next",
      "mergeMethod": "squash"
    }
  }
}
