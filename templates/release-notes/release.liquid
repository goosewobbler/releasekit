{%- comment -%}
Categories are pre-ordered by the pipeline (New → Fixed → Changed → Removed → Documentation → Developer).
Breaking changes are moved out of their category into a Breaking section first, as the built-in renderer does.
{%- endcomment -%}
{%- for version in versions %}
{%- unless perPackage %}

## `{{ version.packageName }}` @ {{ version.version }}
{%- endunless %}
{%- if version.isFirstRelease %}

_First release of `{{ version.packageName }}`._
{%- endif %}

{%- if version.enhanced.categories %}
{%- assign breaking = "" | split: "" %}
{%- for cat in version.enhanced.categories %}
{%- assign catBreaking = cat.entries | where: "breaking" %}
{%- assign breaking = breaking | concat: catBreaking %}
{%- endfor %}
{%- else %}
{%- assign breaking = version.entries | where: "breaking" %}
{%- endif %}
{%- if breaking.size > 0 %}

### Breaking:
{%- for entry in breaking %}
- {% if entry.scope %}**{{ entry.scope }}**: {% endif %}{{ entry.description }}{% if entry.issueIds %} ({{ entry.issueIds | join: ", " }}){% endif %}
{%- endfor %}
{%- endif %}

{%- if version.enhanced.categories %}
{%- for cat in version.enhanced.categories %}
{%- assign catEntries = cat.entries | reject: "breaking" %}
{%- if catEntries.size > 0 %}

### {{ cat.name }}:
{%- for entry in catEntries %}
{%- if entry.scope %}
- **{{ entry.scope }}**: {{ entry.description }}{% if entry.issueIds %} ({{ entry.issueIds | join: ", " }}){% endif %}
{%- else %}
- {{ entry.description }}{% if entry.issueIds %} ({{ entry.issueIds | join: ", " }}){% endif %}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- else %}
{%- comment -%}Fallback: no LLM categories, use conventional commit types{%- endcomment -%}
{%- assign nonBreaking = version.entries | reject: "breaking" %}
{%- assign added = nonBreaking | where: "type", "added" %}
{%- assign fixed = nonBreaking | where: "type", "fixed" %}
{%- assign changed = nonBreaking | where: "type", "changed" %}
{%- assign removed = nonBreaking | where: "type", "removed" %}
{%- if added.size > 0 %}

### New:
{%- for entry in added %}
- {% if entry.scope %}**{{ entry.scope }}**: {% endif %}{{ entry.description }}{% if entry.issueIds %} ({{ entry.issueIds | join: ", " }}){% endif %}
{%- endfor %}
{%- endif %}
{%- if fixed.size > 0 %}

### Fixed:
